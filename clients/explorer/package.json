{
  "name": "univ-explorer",
  "version": "0.0.0",
  "private": true,
  "description": "Univ Explorer: a mouse-driven 3D view of Univ Server's releases around Earth.",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "vitest run --coverage",
    "fallow": "fallow --quiet --coverage coverage/coverage-final.json",
    "check": "pnpm typecheck && pnpm test && pnpm fallow && pnpm build",
    "e2e": "playwright test",
    "first-points": "node scripts/first-points.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "univ-tile-decoder": "link:../tile-decoder",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-istanbul": "4.1.12",
    "fallow": "3.38.1",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
